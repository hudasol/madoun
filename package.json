{
  "name": "madoun",
  "version": "1.6.0",
  "private": true,
  "description": "Shared shipment evidence file and risk-lane engine for faster, pre-arrival customs clearance.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "a11y": "node scripts/a11y.mjs http://localhost:3000",
    "security": "node scripts/security-check.mjs http://localhost:3000",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > docs/sbom.cdx.json",
    "bench": "tsx scripts/bench.ts",
    "worldhash": "tsx scripts/worldhash.ts",
    "eval": "tsx scripts/eval.ts",
    "cell": "tsx scripts/cell.ts",
    "offline": "node scripts/offline-check.mjs 3300",
    "lint": "oxlint",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm test",
    "benchmark": "tsx scripts/benchmark.ts",
    "reference-data": "node scripts/fetch-reference-data.mjs",
    "baselines": "tsx scripts/baselines.ts"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "next": "^16.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "fast-check": "^4.10.2",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.64.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
